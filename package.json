{
  "name": "zhiti-atlas",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build && npm run build:server && node scripts/build-notices.mjs",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist-server/index.cjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "dev:web": "vite --host 0.0.0.0",
    "start": "node dist-server/index.cjs",
    "docker:up": "bash scripts/docker.sh up",
    "docker:down": "bash scripts/docker.sh down",
    "docker:restart": "bash scripts/docker.sh restart",
    "docker:status": "bash scripts/docker.sh status",
    "docker:logs": "bash scripts/docker.sh logs",
    "docker:check": "bash scripts/docker.sh check",
    "test:smoke": "node scripts/verify-production.mjs",
    "check": "npm test && npm run build && npm run test:smoke",
    "release:pack": "npm run build && node scripts/package-release.mjs",
    "release:check": "node scripts/package-release.mjs && node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^10.0.5",
    "esbuild": "0.28.2",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.5"
  },
  "description": "Interactive 3D human anatomy and health education atlas.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zbyisredeemer/3D-person-part-cure-sys.git"
  },
  "homepage": "https://github.com/zbyisredeemer/3D-person-part-cure-sys#readme",
  "bugs": {
    "url": "https://github.com/zbyisredeemer/3D-person-part-cure-sys/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "anatomy",
    "education",
    "threejs",
    "react",
    "medical-education"
  ]
}
