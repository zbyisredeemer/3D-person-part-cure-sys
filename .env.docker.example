# Copy to .env.docker only when changing these defaults.
# Run scripts/docker.sh up again after editing; restart does not reload configuration.
ATLAS_PORT=8080

# Optional online AI. Empty values keep all questions in local education mode.
# Never commit .env.docker or put secrets in VITE_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
